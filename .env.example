# Public URL of the app — REQUIRED in production (password-reset links are built from it)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB connection string (Atlas free tier works)
MONGODB_URI=

# Long random string used to sign session cookies: openssl rand -base64 32
AUTH_SECRET=

# AI providers — set one or both. Each workspace picks its provider/model in Settings.
# Claude: console.anthropic.com   ·   Gemini: aistudio.google.com (free tier available)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Razorpay (dashboard.razorpay.com → Account & Settings → API keys). Use test keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Settings → Webhooks, events: payment.captured, order.paid) → POST /api/billing/webhook
RAZORPAY_WEBHOOK_SECRET=

# Email for password-reset links (any SMTP provider; for Gmail use an App Password).
# Without these, reset links are printed in the server log instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional sender, e.g. Smart CRM <no-reply@yourdomain.com>
MAIL_FROM=

# Optional: separate signing key for platform-admin sessions (defaults to one derived from AUTH_SECRET).
PLATFORM_AUTH_SECRET=

# Platform admin console (/admin/login) uses its own accounts — create the first with:
#   npm run create-admin -- you@company.com "Your Name"
